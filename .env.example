# Copy to .env and fill in. .env is gitignored.
#
# The macOS launcher (see MAC-APP.md) reads the Cursor API key from 1Password
# with the `op` CLI and passes it to server.mjs as CURSOR_API_KEY. Put the key
# in 1Password, not in this file.

# 1Password item ID (or exact title) that holds your Cursor API key.
# Find it with: op item list --categories "API Credential"
CURSOR_API_KEY_OP_ITEM=

# Field on that item that holds the key. "credential" is the field on
# 1Password's API Credential item type.
CURSOR_API_KEY_OP_FIELD=credential

# How often the launcher's server lists cloud agents, in milliseconds.
# Minimum 1000. Default 60000 (once a minute).
CLOUD_POLL_MS=60000
